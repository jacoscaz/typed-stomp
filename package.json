{
  "name": "typed-stomp",
  "version": "0.1.0",
  "description": "STOMP over WebSocket client and server for browser-side and server-side JavaScript runtimes",
  "license": "MIT",
  "author": "Jacopo Scazzosi <jacopo@scazzosi.com>",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./codec": {
      "types": "./dist/codec/index.d.ts",
      "default": "./dist/codec/index.js"
    },
    "./frames": {
      "types": "./dist/frames/index.d.ts",
      "default": "./dist/frames/index.js"
    },
    "./transport": {
      "types": "./dist/transport/index.d.ts",
      "default": "./dist/transport/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"test/**/*.test.ts\"",
    "test:interop": "node --test --test-timeout=900000 \"test/interop/*.interop.ts\"",
    "check": "npm run typecheck && npm test",
    "prepack": "npm run build"
  },
  "keywords": [
    "stomp",
    "websocket",
    "messaging",
    "client",
    "server",
    "typescript"
  ],
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/ws": "8.18.2",
    "typescript": "7.0.2",
    "ws": "8.22.2"
  }
}
